{
  "spec": {
    "title": "Arduino 最小系统板",
    "summary": "一块可 7~12V 外部供电、带电源指示与 I2C 传感器接口的 Arduino 兼容最小系统板。",
    "functions": [
      "提供 Arduino 兼容主控最小系统运行环境（复位、时钟、启动配置）",
      "板载电源指示，上电即亮",
      "一路 I2C 传感器接口，含总线供电与上拉",
      "7~12V 直流输入经板载稳压转为系统工作电压",
      "引出主控可用 I/O 与调试/下载通道，便于二次开发"
    ],
    "supply_rails": [
      "+5V",
      "GND",
      "+3.3V"
    ],
    "interfaces": [
      "I2C",
      "UART",
      "GPIO",
      "ICSP",
      "外部直流电源输入"
    ],
    "key_parts": [
      "Arduino 兼容主控芯片（ATmega 系列）",
      "线性稳压器（7~12V 转 5V）",
      "16MHz 晶振",
      "复位按键与上拉复位电路",
      "电源指示 LED 及限流电阻",
      "I2C 总线上拉电阻",
      "I2C 接口连接器",
      "直流电源输入端子或插座",
      "去耦与滤波电容"
    ],
    "constraints": {
      "尺寸": "小型板卡，约 50mm × 35mm 量级，单板布局",
      "供电": "外部直流 7~12V 输入，板载稳压至 +5V 系统电压，并具备反接与过流基本防护"
    }
  },
