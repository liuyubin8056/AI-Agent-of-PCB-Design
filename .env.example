# 复制为 .env 后填写。全部变量都有默认值，留空即走离线 Mock 后端。
# 任意 OpenAI 兼容接口均可：DeepSeek / 通义千问 / 智谱 / 学校算力平台 / 本地 Ollama。

PCB_LLM_BASE_URL=https://api.deepseek.com/v1
PCB_LLM_API_KEY=
PCB_LLM_MODEL=deepseek-chat

# 离线模式：true 时完全不调用网络，用内置规则引擎走完整条流水线（默认 true）
PCB_OFFLINE=true

# 单次设计最多允许几轮「审查-返修」闭环
PCB_MAX_ROUNDS=3

# KiCad 命令行工具路径，留空则在 PATH 中查找
KICAD_CLI=
